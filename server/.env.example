# KitchenOwl URL, LLT, and optional OpenAI credentials are entered in the first-run web setup wizard.
# Bind to a LAN address or 127.0.0.1 behind your existing HTTPS reverse proxy
BIND_ADDRESS=0.0.0.0
PORT=8999
WHISPER_MODEL=base
# The speech worker runs only while extracting a video (seconds).
WHISPER_TIMEOUT_SECONDS=780
