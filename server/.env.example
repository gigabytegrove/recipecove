# Address of the existing KitchenOwl application, reachable from Docker
KITCHENOWL_URL=http://kitchenowl:8080
# Bind to a LAN address or 127.0.0.1 behind your existing HTTPS reverse proxy
BIND_ADDRESS=0.0.0.0
PORT=8999
WHISPER_MODEL=base
# Optional: enables AI structuring for recipe text, captions, OCR, and video speech
# Without this, deterministic parsing still works but unstructured reels often need manual editing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
